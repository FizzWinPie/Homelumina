# Database connection settings
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# Database pool settings
DB_POOL_MAX=20                # Maximum number of clients in the pool
DB_POOL_IDLE_TIMEOUT=30000    # Close idle clients after 30 seconds (ms)
DB_POOL_CONN_TIMEOUT=2000     # Return error after 2 seconds if connection could not be established (ms)

# Statement and lock timeouts (ms)
DB_STATEMENT_TIMEOUT=30000    # Cancel queries that take longer than 30 seconds
DB_LOCK_TIMEOUT=10000         # Lock timeout for session (ms)

# Environment
NODE_ENV=development

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_MAX_SIZE=5242880
LOG_FILE_MAX_FILES=5

# Cache Configuration
CACHE_TTL_MINUTES=30          # Cache TTL in minutes (default: 30)
CACHE_CHECK_PERIOD_MINUTES=10 # Cache cleanup check period in minutes (default: 10)
CACHE_MAX_KEYS=51             # Maximum cache keys (default: 50 states + 1 default)
DEFAULT_CITIES_LIMIT=3        # Number of featured cities to return (default: 3)

# Test IP Configuration (for localhost/private IPs)
# When running locally, this IP will be used for geolocation lookup
# If TEST_IP is not set, the system will use default featured cities (not location-based)
TEST_IP=8.8.8.8              # Required for local development geolocation testing
# TEST_IP=1.1.1.1            # Cloudflare DNS (San Francisco, CA)
# TEST_IP=208.67.222.222     # OpenDNS (San Jose, CA)
# TEST_IP=74.125.224.72      # Google (Mountain View, CA)

# Optional SSL Configuration (for production)
# DB_SSL_CA=/path/to/ca-certificate.pem
# DB_SSL_CERT=/path/to/client-certificate.pem
# DB_SSL_KEY=/path/to/client-key.pem

# Server Configuration
PORT=3000
HOST=localhost 